<Window x:Class="WpfApp2.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="AddTaskWindow" Height="280" Width="395">
    <Grid>
        <TextBox x:Name="TitleTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="360" Height="23" Margin="10,10,0,0" TextWrapping="Wrap" Text="Title"/>
        <TextBox x:Name="DescriptionTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="360" Height="100" Margin="10,40,0,0" TextWrapping="Wrap" Text="Decription"/>
        <ComboBox x:Name="PriorityComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Margin="10,150,0,0">
            <ComboBoxItem Content="Low"/>
            <ComboBoxItem Content="Medium"/>
            <ComboBoxItem Content="High"/>
        </ComboBox>
        <Button Content="Save" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="30" Margin="10,200,0,0" Click="Button_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="30" Margin="295,200,0,0" Click="Button_Click_1"/>
    </Grid>
</Window>
