<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="310" Width="535">
    <Grid>
        <ListBox x:Name="TaskListBox" HorizontalAlignment="Left" Height="200" VerticalAlignment="Top" Width="500" Margin="10,10,0,0"/>
        <Button Content="Add task" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="30" Margin="10,235,0,0" Click="Button_Click"/>
        <Button Content="Edit task" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="30" Margin="200,235,0,0" Click="Button_Click_1"/>
        <Button Content="Delete task" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="30" Margin="390,235,0,0" Click="Button_Click_2"/>
    </Grid>
</Window>
